# Portal-NG application, shared by the HTTP and built-in TLS modes (rendered by envsubst at startup).
server_tokens off;
# Above MAX_UPLOAD_MB (10 by default): the backend is what enforces the limit and returns a
# readable 413, rather than nginx cutting the connection.
client_max_body_size 16m;

# Real client IP from the reverse proxy (X-Forwarded-For), only from TRUSTED_PROXIES
include /tmp/nginx/real-ip.inc;

include /etc/nginx/portal/headers.inc;

root /usr/share/nginx/html;

location /api/ {
    proxy_pass http://${BACKEND_HOST}:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # After real_ip: $remote_addr is the real client address
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 60s;
}

# Images bundled with the frontend (logo, favicon): baked into the image, so they only ever
# change with an upgrade.
location ~* ^/(logo|favicon|apple-touch-icon)\.png$ {
    include /etc/nginx/portal/headers.inc;
    add_header Cache-Control "public, max-age=86400" always;
    try_files $uri =404;
}

location /assets/ {
    expires 1y;
    include /etc/nginx/portal/headers.inc;
    add_header Cache-Control "public, immutable" always;
    try_files $uri =404;
}

location / {
    include /etc/nginx/portal/headers.inc;
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri/ /index.html;
}
