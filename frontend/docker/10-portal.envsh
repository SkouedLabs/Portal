#!/bin/sh
# Sourced (not executed) by the nginx entrypoint, as the unprivileged nginx user (uid 101),
# before the templates are rendered: the variables exported here reach the next scripts.
# No "set -e" / "exit" here: this file runs inside the entrypoint shell.

mkdir -p /tmp/nginx/conf.d

# --- Mode: plain HTTP behind a reverse proxy (default) or built-in TLS --------------------
case "$(echo "${FRONTEND_TLS:-false}" | tr '[:upper:]' '[:lower:]')" in
  true|1|yes|on) PORTAL_MODE=tls ;;
  *)             PORTAL_MODE=http ;;
esac
export NGINX_ENVSUBST_TEMPLATE_DIR="/etc/nginx/templates-$PORTAL_MODE"

# --- Real client IP: one set_real_ip_from per trusted proxy (space or comma separated) ----
{
  for cidr in $(echo "${TRUSTED_PROXIES:-127.0.0.1/32}" | tr ',' ' '); do
    echo "set_real_ip_from $cidr;"
  done
  echo "real_ip_header X-Forwarded-For;"
  echo "real_ip_recursive on;"
} > /tmp/nginx/real-ip.inc

# --- Built-in TLS: certificate from /etc/nginx/certs, self-signed one generated if missing --
if [ "$PORTAL_MODE" = tls ]; then
  CERT_DIR=/etc/nginx/certs
  if [ ! -s "$CERT_DIR/tls.crt" ] || [ ! -s "$CERT_DIR/tls.key" ]; then
    if [ -w "$CERT_DIR" ]; then
      echo "portal-ng: no certificate provided, generating a self-signed one (ECDSA P-384)"
      openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:secp384r1 -sha384 -nodes -days 825 \
        -subj "/CN=${TLS_COMMON_NAME:-localhost}" \
        -addext "subjectAltName=DNS:${TLS_COMMON_NAME:-localhost},DNS:localhost,IP:127.0.0.1" \
        -keyout "$CERT_DIR/tls.key" -out "$CERT_DIR/tls.crt" 2>/dev/null
      chmod 600 "$CERT_DIR/tls.key"
    else
      echo "portal-ng: ERROR FRONTEND_TLS=true but no tls.crt / tls.key in $CERT_DIR and the directory is not writable." >&2
      echo "portal-ng: mount your certificate there, or a volume to get a generated self-signed one." >&2
      exit 1
    fi
  fi
fi

echo "portal-ng: mode=$PORTAL_MODE, trusted proxies: ${TRUSTED_PROXIES:-127.0.0.1/32}, uid $(id -u)"
